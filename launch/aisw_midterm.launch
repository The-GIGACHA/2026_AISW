<!-- [2026_AISW] 중간점검용 통합 런치: UDP 게이트웨이 + LiDAR 장애물 + 제어 스택 v2 -->
<launch>
  <!-- 시뮬 PC IP (ctrl_cmd 송신 대상). 수신은 0.0.0.0 바인딩이라 무관.
       현재 LAN: 팀 PC 192.168.0.10(enp3s0) <-> 시뮬 192.168.0.1.
       다른 환경이면 sim_ip:=<IP> 로 덮어쓰기 -->
  <arg name="sim_ip" default="192.168.0.1"/>
  <!-- 노드 셔뱅이 다른 PC 경로인 경우 python:=/usr/bin/python3 (cwd="node" 때문에 절대경로) -->
  <arg name="python" default=""/>
  <!-- UDP 2368을 직접 수신 → velodyne 드라이버와 포트 충돌. velodyne 을 따로 띄울 때만 false.
       [2026_AISW] 기본 true: 장애물(/tracked_objects_3d) + AI 구간 스캔(/aisw/lidar_scan) 유일한 출처 -->
  <arg name="lidar_obstacles" default="true"/>
  <!-- 후륜축 → 라이다 전방 거리 [m]. 2026_molit_comp_full_set_2.json: Lidar3D x=0.58 -->
  <arg name="lidar_x" default="0.58"/>
  <!-- [2026_AISW] AI 구간(GPS 음영/회전교차로) 학습 정책 사용. false 면 룰 폴백만. 모델: models/<mode>.npz -->
  <arg name="ai_enable" default="true"/>
  <!-- [2026_AISW] 경로계획기: lattice(기존) / frenet(샘플링 + 객체 예측 + 속도 상한) -->
  <arg name="planner" default="lattice"/>
  <arg name="model_dir" default="$(find aisw_2026)/models"/>
  <!-- MORAI 조향 이득 보상 = 1/실측이득 (로컬 25.S4.MolitComp03: 이득 0.575). 현장은 tools/morai_site_check.py 조향 모드로 재측정 -->
  <arg name="steer_scale" default="1.7391"/>
  <!-- 카메라 3대 UDP 9291/9293/9295 -> /image_jpeg{,_left,_right}/compressed 발행 (녹화/인지 개발용) -->
  <arg name="cam" default="false"/>
  <!-- [2026_AISW] 전역경로 인덱스 구간 설정 (재밍/신호/합류 등). 다른 맵·시나리오면 덮어쓰기 -->
  <arg name="sections_file" default="$(find aisw_2026)/config/kcity_sections.yaml"/>
  <!-- [2026_AISW] 주행 데이터 CSV 기록 (AISW_LOG_DIR, 기본 ~/aisw_logs) — AI 학습 데이터 수집 시 record:=true -->
  <arg name="record" default="false"/>
  <!-- [2026_AISW] 모든 회피 후보가 막혔을 때 정지 (연속 2사이클 확인). 기존 동작은 false -->
  <arg name="stop_on_blocked" default="false"/>

  <param name="/aisw/sections_file" value="$(arg sections_file)"/>

  <node pkg="aisw_2026" type="aisw_udp_bridge.py" launch-prefix="$(arg python)" name="aisw_udp_bridge" output="screen" respawn="true">
    <param name="sim_ip" value="$(arg sim_ip)"/>
    <param name="steer_scale" value="$(arg steer_scale)"/>
    <param name="cam" value="$(arg cam)"/>
  </node>

  <node pkg="aisw_2026" type="aisw_lidar_obstacles.py" launch-prefix="$(arg python)" name="aisw_lidar_obstacles" output="screen" respawn="true" if="$(arg lidar_obstacles)">
    <param name="lidar_x" value="$(arg lidar_x)"/>
  </node>

  <!-- 규정집 미션 위치 RViz 마커 (/aisw/mission_markers) -->
  <node pkg="aisw_2026" type="mission_markers.py" launch-prefix="$(arg python)" name="aisw_mission_markers" output="log"/>

  <env name="PYTHONUNBUFFERED" value="1"/>
  <node pkg="aisw_2026" type="master_v2.py" launch-prefix="$(arg python)" name="master_controller_node"
        output="screen" respawn="true" cwd="node">
    <param name="ai_enable" value="$(arg ai_enable)"/>
    <param name="model_dir" value="$(arg model_dir)"/>
  </node>
  <node pkg="aisw_2026" type="frenet_planner_node.py" launch-prefix="$(arg python)" name="lattice_planner"
        output="screen" respawn="true" cwd="node" if="$(eval arg('planner') == 'frenet')"/>
  <node pkg="aisw_2026" type="lattice_planner_v2.py" launch-prefix="$(arg python)" name="lattice_planner"
        output="screen" respawn="true" cwd="node" if="$(eval arg('planner') == 'lattice')">
    <param name="stop_on_blocked" value="$(arg stop_on_blocked)"/>
  </node>

  <node pkg="aisw_2026" type="data_recorder.py" launch-prefix="$(arg python)" name="aisw_data_recorder"
        output="screen" if="$(arg record)"/>
</launch>
